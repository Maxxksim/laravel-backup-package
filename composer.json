{
  "name": "maxxksim/laravel-backup-package",
  "description": "Create database backups and keep the latest N copies.",
  "autoload": {
    "psr-4": {
      "Maksym\\LaravelBackupPackage\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Maksym",
      "email": "makximchagin@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "illuminate/console": "^12.0||^13.0",
    "illuminate/contracts": "^12.0||^13.0",
    "illuminate/support": "^12.0||^13.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Maksym\\LaravelBackupPackage\\BackupPackageProvider"
      ],
      "aliases": {
        "Backup": "Maksym\\LaravelBackupPackage\\Facades\\BackupPackage"
      }
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.3",
    "laravel/pint": "^1.32"
  }
}
